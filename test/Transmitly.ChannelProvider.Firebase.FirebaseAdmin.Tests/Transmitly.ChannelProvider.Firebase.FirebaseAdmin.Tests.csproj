<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0;net6.0</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup>
		<TargetFrameworks Condition=" '$(OS)' == 'Windows_NT'">net48;net472;$(TargetFrameworks);</TargetFrameworks>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net6.0'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
	</ItemGroup>
	<!-- Test.Sdk 18 and MSTest 4 dropped net6.0; these are the last versions that run it. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
		<PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Transmitly.ChannelProvider.Firebase.FirebaseAdmin\Transmitly.ChannelProvider.Firebase.FirebaseAdmin.csproj" />
	</ItemGroup>
</Project>
